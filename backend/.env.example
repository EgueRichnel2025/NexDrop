NEXDROP_APP_NAME="NexDrop API"
NEXDROP_ENVIRONMENT=development
NEXDROP_API_V1_PREFIX=/api/v1
NEXDROP_SERVER_HOST=127.0.0.1
NEXDROP_SERVER_PORT=8765
NEXDROP_SERVER_RELOAD=true
NEXDROP_LOG_LEVEL=INFO
NEXDROP_CORS_ORIGINS=[]
# Generate a random secret (for example: python -c "import secrets; print(secrets.token_hex(32))").
# Use the SAME value for POSTGRES_PASSWORD and the password in NEXDROP_DATABASE_URL.
NEXDROP_POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_64_CHARACTER_HEX_SECRET
NEXDROP_DATABASE_URL=postgresql+psycopg://nexdrop:REPLACE_WITH_A_RANDOM_64_CHARACTER_HEX_SECRET@127.0.0.1:5434/nexdrop
