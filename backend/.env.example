NEXDROP_APP_NAME="NexDrop API"
NEXDROP_ENVIRONMENT=development
NEXDROP_API_V1_PREFIX=/api/v1
NEXDROP_LOG_LEVEL=INFO
NEXDROP_CORS_ORIGINS=[]
# Use the SQLAlchemy async Psycopg dialect. Replace the placeholder password locally.
NEXDROP_DATABASE_URL=postgresql+psycopg://nexdrop:CHANGE_ME@127.0.0.1:5432/nexdrop
